import java.util.*;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        int[] arr = new int[10];
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int loc = sc.nextInt();
        int key = sc.nextInt();

        for (int i = n; i > loc; i--) {
            arr[i] = arr[i - 1];
        }
        arr[loc] = key;

        for (int i = 0; i <= n; i++) {
            System.out.print(arr[i] + "\t");
        }
    }
}



