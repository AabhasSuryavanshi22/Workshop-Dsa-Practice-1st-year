Binary
public class Main {
    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5};
        int key = 2;
        int low = 0;
        int high = arr.length - 1;
        boolean flag = false;

        while (low <= high && !flag) {
            int mid = (low + high) / 2;
            if (key == arr[mid]) {
                flag = true;
            } else if (key < arr[mid]) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        if (flag) {
            System.out.println("key found");
        } else {
            System.out.println("key not found");
        }
    }
}



class Solution {
    public int search(int[] nums, int target) {
        int low = 0;
        int high = nums.length - 1;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (nums[mid] == target) {
                return mid;
            } else if (target < nums[mid]) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return -1;
    }
}





















